{
  "manifest_version": 3,
  "name": "Aurora CPF Cleaner",
  "version": "1.0.0",
  "description": "Oculta automaticamente elementos com a classe .aluno-cpf em qualquer site.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Aurora CPF Cleaner",
    "default_popup": "popup.html"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_start"
  }]
}
